oney tastes sweet.","opposite":null,"illustrationKey":"sweet","entryType":"vocabulary"},{"id":"sour","category":"food-taste","word":"sour","ipa":"","pos":"adj.","definition":"having a sharp taste like lemon","sentence":"This lemon is sour.","opposite":null,"illustrationKey":"sour","entryType":"vocabulary"},{"id":"salty","category":"food-taste","word":"salty","ipa":"","pos":"adj.","definition":"having a taste of salt","sentence":"The soup is too salty.","opposite":null,"illustrationKey":"salty","entryType":"vocabulary"},{"id":"bitter","category":"food-taste","word":"bitter","ipa":"","pos":"adj.","definition":"having a strong taste that is not sweet, like some coffee","sentence":"The black coffee tastes bitter.","opposite":null,"illustrationKey":"bitter","entryType":"vocabulary"},{"id":"spicy","category":"food-taste","word":"spicy","ipa":"","pos":"adj.","definition":"having a strong hot flavour from spices","sentence":"This chilli sauce is spicy.","opposite":null,"illustrationKey":"spicy","entryType":"vocabulary"},{"id":"delicious","category":"food-taste","word":"delicious","ipa":"","pos":"adj.","definition":"very pleasant to eat","sentence":"The meal is delicious.","opposite":null,"illustrationKey":"delicious","entryType":"vocabulary"},{"id":"healthy","category":"food-taste","word":"healthy","ipa":"","pos":"adj.","definition":"good for your body or in good physical condition","sentence":"A balanced meal is healthy.","opposite":"unhealthy","illustrationKey":"healthy","entryType":"vocabulary"},{"id":"unhealthy","category":"food-taste","word":"unhealthy","ipa":"","pos":"adj.","definition":"bad for your health or not in good health","sentence":"Eating only sweets is unhealthy.","opposite":"healthy","illustrationKey":"unhealthy","entryType":"vocabulary"}]