[{"id":"open-state","category":"condition-state","word":"open","ipa":"/ˈəʊpən/","pos":"adj.","definition":"not closed; allowing entrance","sentence":"The wooden front door is wide open.","opposite":"closed-state","illustrationKey":"open-state","entryType":"vocabulary","senseLabel":"not closed"},{"id":"closed-state","category":"condition-state","word":"closed","ipa":"/kləʊzd/","pos":"adj.","definition":"blocked or sealed shut","sentence":"Keep the window tightly closed on stormy days.","opposite":"open-state","illustrationKey":"closed-state","entryType":"vocabulary"},{"id":"clean-state","category":"condition-state","word":"clean","ipa":"/kliːn/","pos":"adj.","definition":"free from dirt, marks, or stains","sentence":"The washed ceramic plate is spotless and clean.","opposite":"dirty-state","illustrationKey":"clean-state","entryType":"vocabulary","senseLabel":"not dirty"},{"id":"dirty-state","category":"condition-state","word":"dirty","ipa":"/ˈdɜːti/","pos":"adj.","definition":"covered with dirt, mud, or food stains","sentence":"Put the dirty dishes into the dishwasher sink.","opposite":"clean-state","illustrationKey":"dirty-state","entryType":"vocabulary"},{"id":"wet","category":"condition-state","word":"wet","ipa":"/wet/","pos":"adj.","definition":"covered or saturated with liquid","sentence":"Hang the wet dripping t-shirt out in the breeze.","opposite":"dry","illustrationKey":"wet","entryType":"vocabulary"},{"id":"dry","category":"condition-state","word":"dry","ipa":"/draɪ/","pos":"adj.","definition":"free from moisture or liquid","sentence":"The laundry is completely dry and warm now.","opposite":"wet","illustrationKey":"dry","entryType":"vocabulary","senseLabel":"not wet"},{"id":"full","category":"condition-state","word":"full","ipa":"/fʊl/","pos":"adj.","definition":"containing as much as possible","sentence":"This glass is full of sweet, chilled orange juice.","opposite":"empty","illustrationKey":"full","entryType":"vocabulary"},{"id":"empty","category":"condit