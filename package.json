{
  "name": "english-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -b --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply english-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply english-db --remote",
    "upload:cards": "node scripts/upload-cards-to-r2.mjs",
    "split:vocab": "node scripts/split-vocab-data.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.41.0",
    "hono": "^4.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.5.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.780.0",
    "@cloudflare/vite-plugin": "^1.0.10",
    "@cloudflare/workers-types": "^5.20261123.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "drizzle-kit": "^0.30.6",
    "typescript": "^5.8.2",
    "vite": "^6.2.5",
    "wrangler": "^4.10.0"
  }
}
